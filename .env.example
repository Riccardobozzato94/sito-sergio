# ═══════════════════════════════════════════════════════════
# Panificio Da Sergio — Variabili d'ambiente (.env)
# Copia questo file in `.env` e sostituisci i placeholder.
# Il sito funziona ANCHE SENZA Supabase (modalità statica/offline):
# in quel caso lascia vuoti VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY.
# ═══════════════════════════════════════════════════════════

# ── Supabase (sito pubblico + admin) ──
# Da: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://gohhqrbcaqvpkcltazzk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Stripe (pagamenti online) ──
# Chiave PUBBLICABILE (lato browser). Da: Stripe Dashboard > Developers > API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# NOTA: la chiave SEGRETA (sk_...) NON va nel .env del sito.
# Si configura solo come secret dell'Edge Function (vedi sotto).

# ── Segreti Edge Function (NON nel .env del sito!) ──
# Si impostano con:
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_live_xxx
#   npx supabase secrets set SITE_URL=https://panificiodasergio.it
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sono forniti automaticamente
#  dall'ambiente Edge Function di Supabase quando deployata via CLI)

# ── (Opzionale) Resend per notifiche email ordini ──
# Da usare solo se si deploya supabase/functions/notify-new-order
# RESEND_API_KEY=re_xxx
# NOTIFY_EMAIL=ordini@panificiodasergio.it
# FROM_EMAIL=ordini@panificiodasergio.it
